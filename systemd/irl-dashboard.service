[Unit]
Description=IRL Server Tailnet dashboard
Wants=irl-mediamtx.service
After=irl-mediamtx.service

[Service]
Type=simple
User=irl-server
Group=irl-server
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=IRL_STATE_DIR=/var/lib/irl-server
ExecStart=/usr/bin/python3 /opt/irl-server/status_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/irl-server
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
